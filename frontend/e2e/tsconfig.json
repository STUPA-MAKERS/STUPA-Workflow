/* TypeScript config for the Playwright E2E tests, apart from the Angular build, because
 * tsconfig.app.json covers only src/**. `npm run e2e:tsc` checks it. */
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../out-tsc/e2e",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "noPropertyAccessFromIndexSignature": false,
    "skipLibCheck": true
  },
  "include": ["**/*.ts", "../playwright.config.ts"]
}
